CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
CORS_ORIGINS=http://localhost:5173
# Orden del proveedor para los vectores de consulta. Usa solo BGE-M3 con el índice actual.
# Ejemplos: local,cloudflare  /  remote,local,cloudflare  /  cloudflare,local
EMBEDDING_PROVIDERS=cloudflare
EMBEDDING_LOCAL_DEVICE=auto
EMBEDDING_LOCAL_MODEL=BAAI/bge-m3
# Opcional: endpoint OpenAI-compatible POST /v1/embeddings que sirva el mismo BAAI/bge-m3.
EMBEDDING_REMOTE_URL=
EMBEDDING_REMOTE_MODEL=BAAI/bge-m3
EMBEDDING_REMOTE_API_KEY=
