# =============================================================================
# FRONTEND WEB (Vite)
# Estas variables son públicas y quedan incluidas en la compilación del frontend.
# =============================================================================
VITE_API_URL=http://localhost:8000
# URL base del backend del agente. En producción usa la URL del servicio de Render.
VITE_AGENT_URL=http://localhost:8787

# =============================================================================
# SERVICIO DEL AGENTE (Node.js)
# Variables privadas del proceso ejecutado mediante `npm run dev:agent`.
# =============================================================================
# Puerto local. En Render se utiliza automáticamente la variable PORT de la plataforma.
AGENT_PORT=8787
AGENT_HOST=0.0.0.0
# URL pública del servicio; se muestra en el registro de inicio.
AGENT_PUBLIC_URL=http://localhost:8787
# Orígenes del frontend autorizados para CORS; separa varios con coma.
AGENT_ALLOWED_ORIGINS=http://localhost:5173
# API principal de Grafema que consulta el agente.
GRAFEMA_API_URL=http://localhost:8000
AGENT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# =============================================================================
# PERSISTENCIA DEL DATASET (Supabase)
# Solo servidor. Reutiliza el proyecto Supabase del catálogo.
# =============================================================================
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Cadena secreta de 16+ caracteres para revisar y exportar desde la interfaz.
DATASET_ADMIN_TOKEN=

# =============================================================================
# GENERACIÓN DE SERVICIOS POR LOTES
# Solo servidor. Requiere DATASET_ADMIN_TOKEN y la migración 004.
# =============================================================================
SERVICE_BATCH_ENABLED=false
SERVICE_BATCH_TARGET=70

# =============================================================================
# PROVEEDOR DE IA: CLOUDFLARE WORKERS AI
# Solo servidor.
# =============================================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Modelos autorizados para el selector; separa varios con coma.
AGENT_CLOUDFLARE_MODELS=@cf/meta/llama-4-scout-17b-16e-instruct

# =============================================================================
# PROVEEDOR DE IA: OPENROUTER (opcional)
# Solo servidor.
# =============================================================================
OPENROUTER_API_KEY=
AGENT_OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct,google/gemini-2.5-flash
