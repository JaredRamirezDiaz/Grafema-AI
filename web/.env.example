VITE_API_URL=http://localhost:8000
# Solo servidor: Vercel Function / agente local; no uses prefijo VITE_ con estas claves.
GRAFEMA_API_URL=http://localhost:8000
# Persistencia del dataset (solo servidor). Reutiliza el proyecto Supabase del catálogo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Cadena secreta de 16+ caracteres. Escríbela en la interfaz para revisar y exportar.
DATASET_ADMIN_TOKEN=
# Generación temporal de solicitudes. Requiere token de administración y migración 004.
SERVICE_BATCH_ENABLED=false
SERVICE_BATCH_TARGET=70
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AGENT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Modelo(s) Cloudflare autorizados para el selector. Separa varios con coma.
AGENT_CLOUDFLARE_MODELS=@cf/meta/llama-4-scout-17b-16e-instruct
# Opcional: activa OpenRouter y configura los modelos que quieres probar.
OPENROUTER_API_KEY=
AGENT_OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct,google/gemini-2.5-flash
AGENT_PORT=8787
